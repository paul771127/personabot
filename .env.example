# ── 複製成 .env 再填。.env 已經在 .gitignore 裡,不會進版控。─────────────

# ── 模型後端:anthropic(雲端)或 local(自己電腦上的 Ollama 等)──────
LLM_BACKEND=anthropic

# ── LLM_BACKEND=anthropic 時 ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# 不填的話,雲端預設 claude-opus-5-5 / claude-haiku-5-5
# CHAT_MODEL=claude-opus-5-5
# UTILITY_MODEL=claude-haiku-5-5
# low / medium / high。陪聊用 low 就夠,又快又省(本地後端會忽略這項)
CHAT_EFFORT=low

# ── LLM_BACKEND=local 時 ────────────────────────────────────────────
# Ollama 預設就是這個位址;LM Studio 通常是 http://localhost:1234/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama        # Ollama 不檢查,但有些伺服器會要
LOCAL_TIMEOUT=120           # 本地模型慢,秒數給寬一點
# 不填的話,本地預設 qwen3.5:9b-q8_0 / qwen3.5:2b
# CHAT_MODEL=qwen3.5:9b-q8_0
# UTILITY_MODEL=qwen3.5:2b

MAX_TOKENS=1024

# 角色與資料
PERSONA_PATH=personas/aoi.yaml
DB_PATH=data/personabot.db

# 記憶
WINDOW_MESSAGES=24      # 每次帶幾則近期對話給模型
SUMMARIZE_AFTER=40      # 累積幾則未摘要的訊息就壓成筆記
MAX_FACTS=60            # 每個人最多記幾則長期事實

# 擬真
MAX_BUBBLES=3           # 一次回覆最多拆成幾則訊息
TYPING_INDICATOR=true   # 顯示「輸入中」
TYPING_SPEED_CPS=18     # 估打字時間用的每秒字數
MAX_TYPING_DELAY=3.5    # 泡泡之間最多等幾秒

RATE_LIMIT_PER_MINUTE=20

# ── LINE ────────────────────────────────────────────────────────────
# LINE Developers → Messaging API channel → Basic settings / Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Facebook Messenger ──────────────────────────────────────────────
# Meta for Developers → 你的 App → Settings / Messenger
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=     # 自己隨便取一組,設 webhook 時要填一樣的
MESSENGER_API_VERSION=v21.0

# ── Telegram ────────────────────────────────────────────────────────
# 跟 @BotFather 要
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=    # 自己隨便取一組亂數,用 webhook 時一定要設
