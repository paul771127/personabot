# ════════════════════════════════════════════════════════════════════
#  完全跑在自己電腦上的設定(Ollama)。
#
#  這份是給「12–24GB 顯卡 + 一般記憶體」的機器用的,拿來陪聊剛剛好。
#  用法:  cp .env.ollama.example .env
#
#  先把伺服器開起來(兩個環境變數都要,原因見 README):
#      OLLAMA_CONTEXT_LENGTH=16384 OLLAMA_MAX_LOADED_MODELS=2 ollama serve
#
#  再把模型拉下來:
#      ollama pull qwen3.5:9b-q8_0
#      ollama pull qwen3.5:2b
#
#  然後驗:  python -m personabot.cli --selftest
# ════════════════════════════════════════════════════════════════════

LLM_BACKEND=local
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_TIMEOUT=120

# 不填的話,本地後端的預設值就是下面這兩個,所以通常不用動。
# 顯卡只有 12GB 的話改成 qwen3.5:9b-q4_K_M;只有 8GB 就用 qwen3.5:4b。
CHAT_MODEL=qwen3.5:9b-q8_0
UTILITY_MODEL=qwen3.5:2b

MAX_TOKENS=1024

# 角色與資料
PERSONA_PATH=personas/aoi.yaml
DB_PATH=data/personabot.db

# 記憶:本地後端的預設已經是 16 / 30(比雲端保守,小模型塞太滿會開始出戲)。
# 真的發現它講到後來忘記自己是誰,把 WINDOW_MESSAGES 再往下調到 12。
WINDOW_MESSAGES=16
SUMMARIZE_AFTER=30
MAX_FACTS=60

# 擬真
MAX_BUBBLES=3
TYPING_INDICATOR=true
TYPING_SPEED_CPS=18
MAX_TYPING_DELAY=3.5

RATE_LIMIT_PER_MINUTE=20

# ── 平台(先在終端機玩就不用填)────────────────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
