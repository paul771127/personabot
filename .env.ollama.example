# ════════════════════════════════════════════════════════════════════
#  完全跑在自己電腦上的設定(Ollama)。
#
#  這份是給「12–24GB 顯卡 + 一般記憶體」的機器用的,拿來陪聊剛剛好。
#  用法:  cp .env.ollama.example .env
#
#  模型用腳本一次準備好:
#      Linux / macOS :  ./scripts/setup-ollama.sh
#      Windows       :  powershell -ExecutionPolicy Bypass -File scripts\setup-ollama.ps1
#
#  然後驗:  python -m personabot.cli --selftest
# ════════════════════════════════════════════════════════════════════

LLM_BACKEND=local
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_TIMEOUT=120

# 這兩個是 setup 腳本用 ollama/*.Modelfile 建出來的版本,context 已經調大。
# 顯卡大小不同的話改 ollama/chat.Modelfile 裡的 FROM,再重跑一次腳本。
CHAT_MODEL=personabot-chat
UTILITY_MODEL=personabot-utility

MAX_TOKENS=1024

# 角色與資料
PERSONA_PATH=personas/aoi.yaml
DB_PATH=data/personabot.db

# 記憶:本地後端的預設已經是 16 / 30(比雲端保守,小模型塞太滿會開始出戲)。
# 真的發現它講到後來忘記自己是誰,把 WINDOW_MESSAGES 再往下調到 12。
WINDOW_MESSAGES=16
SUMMARIZE_AFTER=30
MAX_FACTS=60
# 壓摘要的時候多打一次 utility 模型,把講同一件事的記憶併起來。
# 字面上的去重一直都會做,這個管的是語意上的那層。
MERGE_FACTS=true
# 關係狀態:她覺得對方多投入、對方有多在試探、回訊要多快
RAPPORT=true
FAST_REPLY_SECONDS=30      # 幾秒內回算「秒回」
SLOW_REPLY_SECONDS=21600   # 隔多久以上算「晾著」(預設六小時)
COLD_REPLY_CHARS=8         # 幾個字以內算敷衍(「哈哈」這種被逗笑的不算)
GUARD_COOLDOWN_TURNS=10    # 連續幾則沒再試探,戒心降一格
MAX_LEAD_DELAY=25          # 跟著對方的節奏回,但最多讓他等這麼久(秒)

# 擬真
MAX_BUBBLES=3
TYPING_INDICATOR=true
TYPING_SPEED_CPS=18
MAX_TYPING_DELAY=3.5

RATE_LIMIT_PER_MINUTE=20

# ── 平台(先在終端機玩就不用填)────────────────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
